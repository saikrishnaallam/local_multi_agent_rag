# LangSmith Tracing Configuration (Optional)
# To enable tracing, copy this file to '.env' and fill in your LangSmith API key.
LANGCHAIN_TRACING_V2="true"
LANGCHAIN_API_KEY="your-api-key-here"
LANGCHAIN_PROJECT="local-multi-agent-rag"

# Hugging Face Hub Token (Optional)
# Set this to prevent rate limit warnings when downloading Cross-Encoder models.
# HF_TOKEN="your-hf-token-here"
